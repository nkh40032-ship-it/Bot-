# ============================================================
# إعدادات بوت Azora Novels Discord
# انسخ هذا الملف باسم .env وعبّي القيم (محليًا فقط)
# على Railway: تضاف نفس المتغيرات دي من تبويب Variables، مش بملف
# ============================================================

# توكن البوت — من https://discord.com/developers/applications → Bot → Reset Token
DISCORD_TOKEN=

# Client ID (Application ID) — من صفحة General Information لتطبيق البوت
CLIENT_ID=

# (اختياري أثناء التطوير) معرف سيرفر تجريبي لتسجيل الأوامر فيه فورًا
# اتركه فارغًا لتسجيل الأوامر بشكل عام (Global) — يستغرق حتى ساعة للظهور
GUILD_ID=

# معرف روم (Channel ID) اللي هيُنشر فيه إشعارات الروايات/الفصول الجديدة
# فعّل Developer Mode في ديسكورد، ثم كليك يمين على الروم → Copy Channel ID
ANNOUNCE_CHANNEL_ID=

# رابط REST API الخاص بموقعك (يظهر في: لوحة Animax → الإعدادات العامة → بوت ديسكورد)
# مثال: https://azora-novels.com/wp-json/animax/v1/
SITE_API_URL=

# نفس المفتاح السري المضبوط في لوحة تحكم الموقع (Discord Webhook Secret)
WEBHOOK_SECRET=

# البورت اللي هيشتغل عليه سيرفر الإشعارات (Railway بيحدده تلقائيًا عادة)
PORT=3000
